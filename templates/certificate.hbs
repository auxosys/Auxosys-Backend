<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    @page {
      size: 1122px 793px;
      margin: 0;
    }

    body {
      width: 1122px;
      height: 793px;
      font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    }

    .cert {
      position: relative;
      width: 1122px;
      height: 793px;
      background: #FFFFFF;
      overflow: hidden;
    }

    .wave {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    .brand {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 34%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 48px 40px 40px 56px;
      z-index: 2;

      color: {{textColor}};
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: {{logoTextColor}};
    }

    .brand-logo .mark {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-logo .brand-name {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 0.02em;
      margin-top: 3px;
    }

    .brand-mid {
      max-width: 210px;
    }

    .type-tag {
      display: inline-block;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 5px 12px;
      border-radius: 100px;
      margin-bottom: 14px;
      background: rgba(255, 255, 255, 0.18);
    }

    .brand-mid h4 {
      font-size: 14px;
      font-weight: 700;
      margin: 0 0 8px;
      line-height: 1.4;
    }

    .brand-mid p {
      font-size: 11.5px;
      line-height: 1.6;
      margin: 0;
      opacity: 0.75;
    }

    .brand-foot {
      font-size: 12px;
      letter-spacing: 0.05em;
      opacity: 0.9;
    }

    .content {
      position: absolute;
      top: 0;
      right: 0;
      height: 100%;
      width: 66%;
      padding: 140px 64px 44px;
      display: flex;
      flex-direction: column;
      z-index: 2;
      align-items: center;
      text-align: center;
    }

    .eyebrow {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #14B8A6;
      margin-bottom: 10px;
    }

    .title {
      font-size: 34px;
      font-weight: 800;
      color: #0F172A;
      letter-spacing: -0.02em;
      margin: 0 0 26px;
    }

    .line {
      font-size: 13.5px;
      color: #475569;
      margin: 0 0 6px;
    }

    .name {
      font-size: 30px;
      font-weight: 700;
      color: #0F172A;
      margin: 4px 0 18px;
      font-family: Georgia, serif;
      border-bottom: 1.5px solid #E2E8F0;
      padding-bottom: 14px;
      display: inline-block;
    }

    .body {
      font-size: 13.5px;
      color: #475569;
      line-height: 1.85;
      max-width: 480px;
      margin-bottom: auto;
    }

    .body strong {
      color: #0F172A;
      font-weight: 700;
    }

    .foot {
      display: flex;
      justify-content: flex-start;
      gap: 48px;
      align-items: flex-end;
      margin-top: 48px;
      width: 100%;
    }

    .sig {
      text-align: center;
    }

    .sig img {
      height: 46px;
      object-fit: contain;
      margin-bottom: 6px;
    }

    .sig .sig-line {
      width: 150px;
      height: 1px;
      background: #CBD5E1;
      margin-bottom: 8px;
    }

    .sig .sig-name {
      font-size: 12.5px;
      font-weight: 700;
      color: #0F172A;
    }

    .sig .sig-role {
      font-size: 10.5px;
      color: #94A3B8;
    }

    .meta {
      position: absolute;
      bottom: 44px;
      right: 64px;
      text-align: right;
    }

    .meta .id {
      font-size: 10px;
      font-family: 'JetBrains Mono', monospace;
      color: #94A3B8;
      margin-bottom: 4px;
    }

    .meta .qr {
      width: 64px;
      height: 64px;
      margin-left: auto;
      margin-bottom: 8px;
    }

    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 520px;
      height: 520px;
      z-index: -1;
      pointer-events: none;
      opacity: 0.035;
    }
  </style>
</head>

<body>
  <div class="cert">
    <svg class="wave" viewBox="0 0 1122 793" preserveAspectRatio="none">
      <defs>
        <linearGradient id="panelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          {{#each gradientStops}}
          <stop offset="{{this.offset}}%" stop-color="{{this.color}}" />
          {{/each}}
        </linearGradient>
      </defs>
      <path
        d="M420,0 C330,70 300,150 340,230 C380,310 300,390 340,470 C380,550 300,630 340,710 C360,745 380,770 355,793 L0,793 L0,0 Z"
        fill="{{#if isGradient}}url(#panelGrad){{else}}{{solidColor}}{{/if}}" />
    </svg>

    <div class="brand">
      <div class="brand-logo">
        <div class="mark">
          <svg width="40" height="40" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <g transform="translate(100,103)">
              <path d="M -56 -7 A 58 58 0 1 1 43 45" fill="none" stroke="{{logoTextColor}}" stroke-width="4.2"
                opacity="0.5" />
              <line x1="-6" y1="-42" x2="36" y2="16" stroke="{{logoTextColor}}" stroke-width="5.2" stroke-linecap="round" />
              <line x1="36" y1="16" x2="-33" y2="29" stroke="{{logoTextColor}}" stroke-width="5.2" stroke-linecap="round" />
              <line x1="-33" y1="29" x2="-6" y2="-42" stroke="{{logoTextColor}}" stroke-width="3" stroke-linecap="round"
                opacity="0.6" />
              <circle cx="-6" cy="-42" r="10" fill="{{logoTextColor}}" />
              <circle cx="36" cy="16" r="14.5" fill="{{logoTextColor}}" />
              <circle cx="-33" cy="29" r="7.3" fill="{{logoTextColor}}" />
              <circle cx="43" cy="45" r="3.6" fill="{{logoTextColor}}" />
            </g>
          </svg>
        </div>
        <span class="brand-name">AUXOSYS</span>
      </div>
      <div class="brand-mid">
        <span class="type-tag">{{typeLabel}}</span>
        <h4>Building intelligent digital products that scale businesses</h4>
        {{#if fields.employeeId}}<p
          style="font-family: 'JetBrains Mono', monospace; font-size: 11.5px; margin-top: 8px; opacity: 0.85;">Emp. ID:
          {{fields.employeeId}}</p>{{/if}}
      </div>
      <div class="brand-foot">auxosys.com · careers@auxosys.com</div>
    </div>

    <div class="content">
      <div class="watermark">
        <svg width="100%" height="100%" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <g transform="translate(100,103)">
            <path d="M -56 -7 A 58 58 0 1 1 43 45" fill="none" stroke="#000000" stroke-width="4.2" />
            <line x1="-6" y1="-42" x2="36" y2="16" stroke="#000000" stroke-width="5.2" stroke-linecap="round" />
            <line x1="36" y1="16" x2="-33" y2="29" stroke="#000000" stroke-width="5.2" stroke-linecap="round" />
            <line x1="-33" y1="29" x2="-6" y2="-42" stroke="#000000" stroke-width="3" stroke-linecap="round" />
            <circle cx="-6" cy="-42" r="10" fill="#000000" />
            <circle cx="36" cy="16" r="14.5" fill="#000000" />
            <circle cx="-33" cy="29" r="7.3" fill="#000000" />
            <circle cx="43" cy="45" r="3.6" fill="#000000" />
          </g>
        </svg>
      </div>

      <div class="eyebrow">{{fields.eyebrow}}</div>
      <div class="title">{{fields.title}}</div>
      <div class="line">{{fields.presentedLine}}</div>
      <div class="name">{{recipientName}}</div>
      <div class="body">{{{fields.bodyHtml}}}</div>

      <div class="foot">
        {{#each signatures}}
        <div class="sig">
          {{#if this.image_url}}<img src="{{this.image_url}}" alt="signature" />{{else}}<div class="sig-line"></div>
          {{/if}}
          <div class="sig-line"></div>
          <div class="sig-name">{{this.name}}</div>
          <div class="sig-role">{{this.designation}}</div>
        </div>
        {{/each}}
      </div>

      <div class="meta">
        <img class="qr" src="{{qrCodeUrl}}" alt="verify QR" />
        <div class="id">Issued {{issueDateFormatted}}</div>
        <div class="id">Cert. ID — {{certificateNumber}}</div>
      </div>
    </div>
  </div>
</body>

</html>